{
  "name": "test-ems-backend",
  "version": "0.2.0",
  "private": true,
  "description": "TEST_EMS Phase 2b backend — bridge integration with Trikona local_server",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/database/migrate-cli.ts",
    "seed:catalogue": "tsx seeds/catalogue.ts",
    "seed:demo-telemetry": "tsx seeds/demo-telemetry.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.1",
    "mysql2": "^3.15.1",
    "pino": "^9.12.0",
    "ws": "^8.22.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}

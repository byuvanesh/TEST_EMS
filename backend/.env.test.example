# TEST_EMS backend — test environment configuration.
# Copy to .env.test and set real credentials for the test database.
# The database MUST end in _test. The guard in testGuard.ts will refuse otherwise.

NODE_ENV=test
HOST=127.0.0.1
PORT=3001
CORS_ORIGIN=http://localhost:5173

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=test_ems_test
MYSQL_USER=test_ems_app
MYSQL_PASSWORD=TestEms_App_Local_2026

MYSQL_MIGRATE_USER=test_ems_migrator
MYSQL_MIGRATE_PASSWORD=TestEms_Migrator_Local_2026

BODY_LIMIT_BYTES=1048576
LOG_LEVEL=silent

# Bridge is NEVER enabled in tests (unit tests use a fake server).
BRIDGE_ENABLED=false
LOCAL_SERVER_URL=http://127.0.0.1:3399
LOCAL_SERVER_USER=admin
LOCAL_SERVER_PASSWORD=admin
GATEWAY_MAC=
LOCAL_SERVER_POLL_INTERVAL_MS=500
LOCAL_SERVER_TIMEOUT_MS=2000
LOCAL_SERVER_MAX_PAYLOAD_BYTES=262144
STALE_THRESHOLD_SECONDS=60
INITIAL_ADMIN_PASSWORD=test_admin_init_pass_2026!
SESSION_SECRET=test_ems_test_session_secret_for_automated_testing_only_32_bytes!

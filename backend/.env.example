# TEST_EMS Phase 2b — local development only. Do not commit real secrets.
# Copy to .env and adjust.

NODE_ENV=development
HOST=127.0.0.1
PORT=3001

# Frontend origin for CORS (Vite default)
CORS_ORIGIN=http://localhost:5173

# Application DB user (DML). Prefer non-root.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=test_ems
MYSQL_USER=test_ems_app
MYSQL_PASSWORD=replace-with-local-secret

# Migrator DB user (DDL). Separate from app where practical.
MYSQL_MIGRATE_USER=test_ems_migrator
MYSQL_MIGRATE_PASSWORD=replace-with-local-secret

# Body size limit (bytes)
BODY_LIMIT_BYTES=1048576

LOG_LEVEL=info

# ── Bridge (Phase 2b) ──────────────────────────────────────────────────────────
# Set BRIDGE_ENABLED=true only when the Trikona local_server is reachable.
# LOCAL_SERVER_URL must be the exact base URL. No trailing slash.
# LOCAL_SERVER_USER/PASSWORD are the local_server login credentials (cookie auth).
# GATEWAY_MAC is the MAC of the gateway you want to ingest from (exact, normalized).
# Never set BRIDGE_ENABLED=true in test or CI environments.
BRIDGE_ENABLED=false
LOCAL_SERVER_URL=http://127.0.0.1:3333
LOCAL_SERVER_USER=admin
LOCAL_SERVER_PASSWORD=replace-with-local-secret
GATEWAY_MAC=
LOCAL_SERVER_POLL_INTERVAL_MS=2000
LOCAL_SERVER_TIMEOUT_MS=5000
LOCAL_SERVER_MAX_PAYLOAD_BYTES=262144
STALE_THRESHOLD_SECONDS=60

# ── Auth & Sessions (Step 3) ──────────────────────────────────────────────────
# Initial admin password: read on bootstrap when users table has no admin.
# Forced password change is enforced on first login (must_change_password=1).
# Never commit the actual password.
INITIAL_ADMIN_PASSWORD=replace-with-secure-initial-admin-password
SESSION_SECRET=replace-with-random-64-character-secret

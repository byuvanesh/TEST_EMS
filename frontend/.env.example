# TEST_EMS frontend — demo sign-in placeholders ONLY.
#
# Copy to `.env.local` (gitignored) for local demo testing.
# Restart the Vite dev server after changing env files.
#
# SECURITY WARNING
# ----------------
# Any variable prefixed with VITE_ is embedded into the client JavaScript
# bundle and is visible to every browser user. These are NOT secrets.
# Do NOT use this mechanism for production authentication.
# Do NOT put production passwords here.
#
# Future production auth requires server-side sessions, hashed passwords
# (Argon2id/bcrypt), HttpOnly cookies, CSRF protection, rate limiting,
# and backend authorization checks — see docs/DEMO_AUTH.md.

# Demo username (placeholder — replace locally; do not commit real values)
VITE_DEMO_USERNAME=

# Demo password (placeholder — replace locally; do not commit real values)
VITE_DEMO_PASSWORD=
